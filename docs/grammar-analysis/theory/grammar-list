(1) <program> -> 
	{<declaration_list><statement_list>}
(2) <declaration_list> -> 
	  <declaration_stat><declaration_list> 
	| ε
(3) <declaration_stat> -> 
	int ID<variable_list>;
(4) <variable_list> -> 
	  ,ID<variable_list> 
	| ε
(5) <statement_list> -> 
	  <statement><statement_list> 
	| ε
(6) <statement> ->
	  <if_stat>
	| <while_stat>
	| <for_stat>
	| <read_stat>
	| <write_stat>
	| <compound_stat>
	| <assignment_stat>
	| ;
(7) <if_stat> ->
	  if(<bool_expression>)<statement><else_part>
(8) <else_part> ->
	  else <statement>
	| ε
(9) <while_stat> ->
	  while(<bool_expression>)<statement>
(10) <for_stat> ->
	  for(<assignment_expression>;<bool_expression>;<assignment_expression>)<statement>
(11) <write_stat> ->
	  write <arithmetic_expression>;
(12) <read_stat> ->
	  read ID;
(13) <compound_stat> ->
	  {<statement_list>}
(14) <assignment_expression> ->
	  ID=<arithmetic_expression>
(15) <assignment_stat> ->
	  <assignment_expression>;
(16) <bool_expression> ->
	  <arithmetic_expression><relop><arithmetic_expression>
(17) <relop> ->
	  >
	| <
	| >=
	| <=
	| ==
	| !=
(18) <arithmetic_expression> ->
	  <term><arithmetic_tail>
(19) <arithmetic_tail> ->
	  +<term><arithmetic_tail>
	| -<term><arithmetic_tail>
	| ε
(20) <term> ->
	  <factor><term_tail>
(21) <term_tail> ->
	  *<factor><term_tail>
	| /<factor><term_tail>
	| ε
(22) <factor> ->
	  (<arithmetic_expression>)
	| ID
	| NUM
